{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"],
    "baseUrl": ".",
    "paths": {
      "@waitloop/protocol": ["packages/protocol/src/index.ts"],
      "@waitloop/game-core": ["packages/game-core/src/index.ts"],
      "@waitloop/doudizhu": ["packages/doudizhu/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "worker/**/*.ts",
    "integrations/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["packages/cli"]
}
