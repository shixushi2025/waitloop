{
  "name": "@waitloop/cli",
  "version": "0.1.0-alpha.7",
  "description": "Waitloop CLI, coding-agent lifecycle adapters, and local MCP Apps bridge.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://waitloop.run",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shixushi2025/waitloop.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/shixushi2025/waitloop/issues"
  },
  "keywords": [
    "waitloop",
    "coding-agent",
    "codex",
    "claude-code",
    "cursor",
    "mcp",
    "mcp-apps"
  ],
  "bin": {
    "waitloop": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run clean && npm run build"
  }
}
