{
  "name": "waitloop",
  "version": "0.0.0",
  "private": true,
  "description": "Tiny games while your coding agent runs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/cloudflare-ci-gate.mjs",
    "dev": "wrangler dev",
    "deploy": "node scripts/cloudflare-ci-gate.mjs --require && wrangler deploy",
    "build:cli": "pnpm --filter @waitloop/cli build",
    "check:repo-contract": "node scripts/validate-repository-contract.mjs && node scripts/validate-onboarding-contract.mjs",
    "check:cli-package": "node scripts/validate-cli-package.mjs",
    "check:mcp-stdio": "pnpm build:cli && node scripts/validate-mcp-stdio.mjs",
    "check:cloudflare-gate": "node scripts/cloudflare-ci-gate.mjs --self-test",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @waitloop/cli typecheck",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
