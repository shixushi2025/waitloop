{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "waitloop",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./apps/web/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "ROOM_CREATE_RATE_LIMITER",
      "namespace_id": "84731001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "HOSTED_ROOM_CREATE_RATE_LIMITER",
      "namespace_id": "84731002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_SESSIONS",
        "class_name": "AgentSession"
      },
      {
        "name": "DEVICE_AUTH",
        "class_name": "DeviceRegistry"
      },
      {
        "name": "PAIRINGS",
        "class_name": "PairingRequest"
      },
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "exports": {
    "AgentSession": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "DeviceRegistry": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "PairingRequest": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
